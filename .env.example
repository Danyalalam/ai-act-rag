# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your key never ends up in git.

# Cluster URL from the Qdrant Cloud console (choose an EU region), e.g.
# https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_URL=

# API key created for that cluster in the Qdrant Cloud console.
QDRANT_API_KEY=
